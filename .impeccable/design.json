  "components": [
    {
      "name": "Primary form button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled action for saving a return note.",
      "html": "<button class=\"ds-example ds-primary\">Save return note</button>",
      "css": ".ds-primary{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;min-height:44px;padding:9px 16px;border:1px solid var(--accent,#a8d8d6);border-radius:2px;background:var(--accent,#a8d8d6);color:var(--bg,#0a1719);font-weight:650;cursor:pointer}.ds-primary:hover{filter:brightness(1.12)}.ds-example:focus-visible{outline:3px solid var(--focus,#efab74);outline-offset:4px}"
    },
    {
      "name": "Quiet button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary action such as clearing a checklist.",
      "html": "<button class=\"ds-example ds-quiet\">Clear checklist</button>",
      "css": ".ds-quiet{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;min-height:44px;padding:9px 16px;border:1px solid var(--control-border,#759093);border-radius:2px;background:transparent;color:var(--quiet-text,#d1e2de);cursor:pointer}.ds-quiet:hover{background:var(--surface-hover,#213638)}.ds-example:focus-visible{outline:3px solid var(--focus,#efab74);outline-offset:4px}"
    },
    {
      "name": "Labeled text field",
      "kind": "input",
      "refersTo": "input",
      "description": "Search or note field with a visible label.",
      "html": "<label class=\"ds-label\" for=\"ds-weapon\">Weapon or sector</label><input class=\"ds-example ds-input\" id=\"ds-weapon\" placeholder=\"Try Factory East or Incinerator\"/>",
      "css": ".ds-label{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;display:block;font-size:15px;font-weight:600;color:var(--text,#ecf1ee)}.ds-input{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;display:block;margin-top:7px;padding:12px 14px;width:100%;min-height:50px;border:1px solid var(--control-border,#759093);border-radius:2px;background:var(--surface,#122326);color:var(--text,#ecf1ee);caret-color:var(--accent,#a8d8d6)}.ds-input::placeholder{color:var(--placeholder,#a8baba);opacity:1}.ds-example:focus-visible{outline:3px solid var(--focus,#efab74);outline-offset:4px}"
    },
    {
      "name": "Navigation disclosure",
      "kind": "nav",
      "refersTo": "nav-panel",
      "description": "One group of the primary navigation.",
      "html": "<details class=\"ds-nav\"><summary class=\"ds-example\"><span class=\"ds-nav-item\"><svg class=\"ds-nav-icon\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 5h9l3 3v11H5V8l2-3Z M8 8h7v5H8Z M8 16h1 M12 16h1 M16 16h1 M15 5V2l4 1\"/></svg>Guides</span><svg class=\"ds-chevron\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"m4 6 4 4 4-4\"/></svg></summary><nav class=\"ds-panel\"><a class=\"ds-example\" href=\"#scanner\">Scanner and door requirements</a><a class=\"ds-example\" href=\"#nodes\">Energy node door will not open</a></nav></details>",
      "css": ".ds-nav{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;color:var(--text,#ecf1ee)}.ds-nav summary{display:flex;align-items:center;gap:7px;min-height:44px;padding:8px 0;cursor:pointer;font-size:14px;list-style:none}.ds-chevron{width:14px;height:14px;color:var(--muted,#b6c6c5);transition:transform .18s ease}.ds-nav[open] .ds-chevron{transform:rotate(180deg)}.ds-panel{width:280px;padding:10px;background:var(--surface,#122326);box-shadow:0 12px 32px #00000030}.ds-panel a{display:flex;align-items:center;min-height:44px;padding:9px 12px;font-size:14px;line-height:1.5;color:var(--text,#ecf1ee);text-decoration:none}.ds-panel a:hover{background:var(--surface-hover,#213638);color:var(--link-hover,#ffffff)}.ds-example:focus-visible{outline:3px solid var(--focus,#efab74);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-chevron{transition:none}} .ds-nav-item{display:flex;align-items:center;gap:7px}.ds-nav-icon{width:16px;height:16px;color:var(--nav-icon,#dfb18c)}"
    },
    {
      "name": "Continuous guide row",
      "kind": "custom",
      "refersTo": "guide-row",
      "description": "A ruled directory entry whose selection fills on hover and focus.",
      "html": "<a class=\"ds-example ds-row\" href=\"#scanner\"><strong>Scanner and door requirements</strong><span>Read the door. Trace its power connection. Find the missing requirement.</span><svg aria-hidden=\"true\" viewBox=\"0 0 32 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M2 12h25M19 4l8 8-8 8\"/></svg></a>",
      "css": ".ds-row{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;display:grid;grid-template-columns:1fr 1.2fr 28px;gap:20px;align-items:center;min-height:70px;padding:18px 24px;border-bottom:1px solid var(--directory-rule,#354447);background:var(--directory,#081619);color:var(--directory-text,#f2f2ed);text-decoration:none;position:relative;isolation:isolate}.ds-row:before{content:\"\";position:absolute;inset:0;background:var(--selection,#d18448);z-index:-1;transform:scaleY(0);transition:transform .32s cubic-bezier(.16,1,.3,1)}.ds-row strong{font-family:\"Big Shoulders\",sans-serif;font-size:32px;font-weight:600;line-height:1.08}.ds-row span{font-size:16px;line-height:1.45;color:var(--directory-muted,#c1d0d0)}.ds-row svg{width:28px;height:24px}.ds-row:is(:hover,:focus-visible):before{transform:scaleY(1)}.ds-row:is(:hover,:focus-visible),.ds-row:is(:hover,:focus-visible) span{color:var(--selection-ink,#131d1a)}.ds-row:focus-visible{outline:3px solid var(--selection-ink,#131d1a);outline-offset:-4px}@media(max-width:680px){.ds-row{grid-template-columns:1fr 28px;gap:9px 18px;min-height:106px;padding-block:19px}.ds-row strong{font-size:27px;line-height:1.12}.ds-row span{grid-column:1;font-size:14px;line-height:1.55}.ds-row svg{grid-column:2;grid-row:1/3}}@media(prefers-reduced-motion:reduce){.ds-row:before{transition:none}}"
    },
    {
      "name": "Notebook entry",
      "kind": "button",
      "refersTo": "notebook-action",
      "description": "Filled link from the pale helper field into the local notebook.",
      "html": "<a class=\"ds-example ds-notebook-action\" href=\"#notes\">Open return notebook <svg aria-hidden=\"true\" viewBox=\"0 0 32 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M2 12h25M19 4l8 8-8 8\"/></svg></a>",
      "css": ".ds-notebook-action{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:50px;padding:10px 12px;background:var(--reading-action,#3d6262);color:#ffffff;text-decoration:none;font-weight:650;font-size:18px;line-height:1.35}.ds-notebook-action svg{width:22px;height:24px;flex-shrink:0}.ds-notebook-action:hover{background:#294b4d;color:#ffffff}.ds-notebook-action:focus-visible{outline:3px solid #934313;outline-offset:4px}@media(max-width:680px){.ds-notebook-action{font-size:16px;padding:12px}}"
    },
    {
      "name": "Checklist row",
      "kind": "custom",
      "refersTo": "checklist-row",
      "description": "Native checkbox and readable task, struck through when complete.",
      "html": "<label class=\"ds-check\"><input class=\"ds-example\" type=\"checkbox\"/><span>Explore every room and shuttle station</span></label>",
      "css": ".ds-check{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;display:flex;align-items:center;gap:14px;padding:12px 0;min-height:48px;border-top:1px solid var(--line,#3f5557);font-weight:450;color:var(--text,#ecf1ee)}.ds-check input{appearance:auto;accent-color:var(--accent,#a8d8d6);width:20px;height:20px;flex-shrink:0;margin:0}.ds-check:has(input:checked) span{text-decoration:line-through;color:var(--muted,#b6c6c5)}.ds-example:focus-visible{outline:3px solid var(--focus,#efab74);outline-offset:4px}"
    },
    {
      "name": "Reference table",
      "kind": "custom",
      "description": "Tonal header and ruled rows with tabular numerals.",
      "html": "<div class=\"ds-table-wrap\"><table class=\"ds-table\"><thead><tr><th>Weapon</th><th>Sector / floor</th></tr></thead><tbody><tr><th scope=\"row\">Missing equipment</th><td>Check the named access tools</td></tr></tbody></table></div>",
      "css": ".ds-table-wrap{overflow-x:auto;border-block:1px solid var(--line,#3f5557);color:var(--text,#ecf1ee)}.ds-table{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:16px;line-height:1.7;border-collapse:collapse;width:100%;font-size:15px;line-height:1.65;font-variant-numeric:tabular-nums}.ds-table th,.ds-table td{padding:16px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line,#3f5557)}.ds-table thead{background:var(--table-head,#213638)}.ds-table th{font-weight:650}.ds-table tbody tr:last-child>*{border-bottom:0}@media(max-width:680px){.ds-table th,.ds-table td{padding:13px 12px;font-size:14px;min-width:100px}}"
    },
